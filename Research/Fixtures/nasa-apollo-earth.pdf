<rdf:Description rdf:about='uuid:e4d637ec-f52c-11d9-983f-000d935371a8' xmlns:xap='http://ns.adobe.com/xap/1.0/' xap:ModifyDate='2005-07-15T08:35:15-04:00' xap:CreateDate='1998-03-09T12:21:28Z' xap:MetadataDate='2005-07-15T08:35:15-04:00'></rdf:Description>
<rdf:Description rdf:about='uuid:e4d637ec-f52c-11d9-983f-000d935371a8' xmlns:xapMM='http://ns.adobe.com/xap/1.0/mm/' xapMM:DocumentID='uuid:13e92d10-f3cb-11d9-9eda-000a95a69ab8'/>
<rdf:Description rdf:about='uuid:e4d637ec-f52c-11d9-983f-000d935371a8' xmlns:dc='http://purl.org/dc/elements/1.1/' dc:format='application/pdf'><dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Apollo 17 View of the Earth pdf</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>NASA</rdf:li></rdf:Seq></dc:creator><dc:description><rdf:Alt><rdf:li xml:lang='x-default'>NASA educational lithograph with picture of the Earth and classroom activities</rdf:li></rdf:Alt></dc:description></rdf:Description>
